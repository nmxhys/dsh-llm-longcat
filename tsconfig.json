{
  "compilerOptions": {
    "target": "ES2024",
    // No `lib` override: Node's own ReadableStream types are async-iterable,
    // while DOM's are not — pulling in DOM here breaks `for await` over an
    // SSE body. This mirrors the upstream harness tsconfig.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
