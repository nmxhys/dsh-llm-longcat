{
  "name": "dsh-llm-longcat",
  "version": "0.1.0",
  "description": "LongCat (LongCat-2.0) adapter for the DeepSeek Harness LLM seam — 1M context, thinking mode, tool calling",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "longcat",
    "llm-provider"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e.js"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
